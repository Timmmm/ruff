{
    "argv0": "ruff",
    "max_filenames": 1000,
    "require_serial": false,
    "args": [
        {
            "name": "command",
            "args": ["format"]
        },
        {
            "name": "default_args",
            "args": ["--no-cache"]
        },
        {
            "name": "extra_args",
            "args": []
        },
        {
            "name": "separator",
            "args": ["--"]
        }
    ],
    "default_match": {
        "or": [
            {
                "shebang_regex": ".*python.*"
            },
            {
                "glob": "*.py"
            }
        ]
    },
    "repo": "https://github.com/timmmm/ruff"
}
